# Supabase Configuration (Public - OK to commit)
VITE_SUPABASE_PROJECT_ID="your-project-id-here"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Private API Keys (NEVER commit actual values)
# These should be stored in GitHub Secrets and Supabase Secrets
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Database Configuration (Private)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_DB_URL="your-database-url"

# Notes:
# - Only VITE_* variables are safe to commit (they're public in browser bundles)
# - All other secrets must be stored securely in GitHub/Supabase Secrets
# - Never commit actual API keys, tokens, or private configuration